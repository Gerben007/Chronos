# Chronos environment template.
# Copy to `.env` on the homelab (chmod 600). Never commit real values.
# Documents the SHAPE of each variable, never the value.

# ── Nextcloud (ingest) ────────────────────────────────────────────────────────
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=chronos-ingest
NEXTCLOUD_APP_PASSWORD=                       # app-password, not account password
NEXTCLOUD_INBOX_PATH=/CC-Library/_inbox
NEXTCLOUD_PROCESSED_PATH=/CC-Library/_processed
NEXTCLOUD_QUARANTINE_PATH=/CC-Library/_quarantine

# ── Anthropic (ingest) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DAILY_HAIKU_BUDGET_USD=1.00                   # halts ingest when reached

# ── SQLite + build paths (both containers) ────────────────────────────────────
SQLITE_PATH=/data/db/chronos.db
ASTRO_DIST_PATH=/data/dist
REBUILD_WEBHOOK_URL=http://web:8080/_rebuild  # internal-only

# ── Google Sheet authoring (site + ingest) ────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_SA_JSON=                        # path to service-account JSON

# ── Admin API (ingest) ────────────────────────────────────────────────────────
ADMIN_API_BIND=0.0.0.0:8001
CF_ACCESS_TEAM=                               # e.g. stratusfinance
CF_ACCESS_AUD=                                # app audience tag from CF

# ── Webhooks (ingest + Apps Script) ───────────────────────────────────────────
WEBHOOK_HMAC_SECRET=                          # ≥32 bytes random

# ── File scanning (ingest) ────────────────────────────────────────────────────
CLAMAV_SOCKET=/var/run/clamav/clamd.sock

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_GPG_RECIPIENT=                         # gpg key ID; private half OFFLINE
BACKUP_OFFSITE_RSYNC_TARGET=                  # rsync target (e.g. user@host:/path)

# ── Site build ────────────────────────────────────────────────────────────────
SITE_BASE_URL=https://chronos.stratusfinance.co.za
DEFAULT_LANG=en
ENGLISH_BIBLE=kjv                             # 'kjv' until ESV licence approved

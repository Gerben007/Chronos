---
// Chronos — TV "lean-back" view.
// Vertical era list with hero card and a row of entries per era.
// Forces TV gamma offset via <html class="tv">; arrow keys / Enter only.

import { LANGS, type Lang } from '../../lib/types';
import { t } from '../../lib/i18n';
import { loadEntries, loadLanes, getLaneBySlug } from '../../lib/data';
import { formatYearRange } from '../../lib/dates';
import '../../styles/tokens.css';
import '../../styles/global.css';
import '../../styles/tv-mode.css';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;

const lanes = loadLanes();
const entries = loadEntries();

// Group entries by 4 broad eras — fixed for Phase 1; era seed data later.
const eras = [
  { slug: 'patriarchs',  label_en: 'Patriarchs',   label_af: 'Aartsvaders',  from: -4100, to: -1400 },
  { slug: 'kingdoms',    label_en: 'Kingdoms',     label_af: 'Konings',      from: -1400, to: -400  },
  { slug: 'christ',      label_en: 'Christ',       label_af: 'Christus',     from: -400,  to: 100   },
  { slug: 'church',      label_en: 'Church age',   label_af: 'Kerk-era',     from: 100,   to: 600   },
];

const eraData = eras.map((era) => {
  const label = lang === 'af' ? era.label_af : era.label_en;
  const items = entries
    .filter((e) => e.start_year >= era.from && e.start_year < era.to)
    .sort((a, b) => b.importance - a.importance || a.start_year - b.start_year)
    .slice(0, 8);
  return { era, label, items };
});
---

<!doctype html>
<html lang={lang} class="tv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chronos · {lang === 'af' ? 'TV-modus' : 'TV mode'}</title>
    <meta name="description" content={t(lang, 'site.tagline')} />
  </head>
  <body class="bg-paper text-ink-2 font-serif antialiased">
    <main class="px-12 py-12 max-w-[1920px] mx-auto">
      <header class="flex items-baseline justify-between mb-9">
        <div>
          <p class="text-xs font-sans uppercase tracking-[0.4em] text-ink-mute">{t(lang, 'site.title')}</p>
          <h1 class="font-serif text-tv-hero text-ink leading-none mt-2">
            {lang === 'af' ? 'Bybelse Geskiedenis' : 'Biblical History'}
          </h1>
          <p class="font-serif italic text-tv-body text-ink-mute mt-4">{t(lang, 'site.tagline')}</p>
        </div>
        <a
          href={`/${lang}/`}
          class="font-sans text-tv-body uppercase tracking-widest text-ink-mute focus:text-ink hover:text-ink no-underline"
        >
          {lang === 'af' ? 'Verlaat TV' : 'Exit TV'}
        </a>
      </header>

      <div class="space-y-12">
        {eraData.map(({ era, label, items }) => (
          <section aria-label={label}>
            <div class="flex items-baseline gap-6 mb-4 border-b border-rule pb-2">
              <h2 class="font-serif text-tv-row text-ink">{label}</h2>
              <span class="font-sans text-xs uppercase tracking-[0.3em] text-ink-faint">
                {era.from < 0 ? `${-era.from} BC` : `AD ${era.from}`} – {era.to < 0 ? `${-era.to} BC` : `AD ${era.to}`}
              </span>
              <span class="ml-auto font-sans text-xs uppercase tracking-[0.3em] text-ink-faint">
                {items.length} {lang === 'af' ? 'inskrywings' : 'entries'}
              </span>
            </div>

            {items.length === 0 ? (
              <p class="italic text-ink-faint">{lang === 'af' ? 'Geen inskrywings nie.' : 'No entries.'}</p>
            ) : (
              <ul class="grid grid-cols-4 gap-6">
                {items.map((e) => {
                  const tr = e.translations[lang] ?? e.translations.en;
                  const lane = getLaneBySlug(e.lane_slug)!;
                  return (
                    <li>
                      <a
                        href={`/${lang}/entry/${e.slug}`}
                        class="tv-card block rounded-lg border bg-paper-2 p-6 no-underline outline-none"
                        style={`border-color:${lane.colour};border-left-width:6px`}
                        tabindex="0"
                      >
                        <span
                          class="inline-block px-2 py-0.5 rounded-sm text-2xs uppercase tracking-widest font-sans"
                          style={`background:${lane.colour_soft};color:${lane.colour}`}
                        >
                          {lang === 'af' && lane.label_af ? lane.label_af : lane.label_en} · {e.type}
                        </span>
                        <h3 class="mt-3 font-serif text-tv-row text-ink leading-tight">{tr.title}</h3>
                        <p class="mt-1 font-serif italic text-tv-body text-ink-mute">
                          {tr.display_dates}
                        </p>
                        <p class="mt-3 font-serif text-base text-ink-2 line-clamp-3">{tr.summary}</p>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))}
      </div>

      <footer class="mt-16 pt-6 border-t border-rule font-sans text-xs uppercase tracking-[0.3em] text-ink-faint flex items-center gap-6">
        <span>← →</span><span>{lang === 'af' ? 'beweeg' : 'move'}</span>
        <span class="mx-2">·</span>
        <span>Enter</span><span>{t(lang, 'timeline.enter_open').toLowerCase()}</span>
      </footer>
    </main>

    <script is:inline>
      // Arrow-key navigation across .tv-card elements.
      // Up/Down jumps a row (4-column grid); Left/Right within a row.
      (function () {
        const cols = 4;
        function cards() { return Array.from(document.querySelectorAll('.tv-card')); }
        function idx() { return cards().findIndex((c) => c === document.activeElement); }
        function focus(n) {
          const all = cards();
          if (!all.length) return;
          const next = Math.max(0, Math.min(all.length - 1, n));
          all[next].focus();
          all[next].scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
        document.addEventListener('keydown', (e) => {
          const i = idx();
          if (i < 0) { if (e.key === 'ArrowDown' || e.key === 'ArrowRight') focus(0); return; }
          switch (e.key) {
            case 'ArrowRight': e.preventDefault(); focus(i + 1); break;
            case 'ArrowLeft':  e.preventDefault(); focus(i - 1); break;
            case 'ArrowDown':  e.preventDefault(); focus(i + cols); break;
            case 'ArrowUp':    e.preventDefault(); focus(i - cols); break;
          }
        });
        // Auto-focus the first card so a remote arrow press works immediately.
        window.addEventListener('load', () => {
          const first = cards()[0];
          if (first) first.focus({ preventScroll: true });
        });
      })();
    </script>
  </body>
</html>

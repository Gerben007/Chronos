---
/*
 * Admin review — file links, quarantine, translation drafts.
 *
 * Auth model: the route sits behind Cloudflare Access (email OTP).
 * CF injects a Cf-Access-Jwt-Assertion header on every request to
 * /admin/api/* which the FastAPI backend verifies against Cloudflare's
 * JWKS. The proxy alone is not trusted.
 *
 * This page renders skeletons; the lists are filled by /admin/review.js
 * fetching the three queues from /admin/api/review/*. CSP forbids
 * inline scripts, so all behaviour lives in a same-origin .js file.
 */
import '../../styles/tokens.css';
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Admin · Chronos</title>
  </head>
  <body class="bg-paper text-ink-2 font-serif antialiased">
    <a href="#main" class="ch-skip-link">Skip to content</a>

    <header class="border-b border-rule bg-paper-2">
      <div class="mx-auto max-w-[1200px] flex items-center gap-4 px-4 py-2.5">
        <span class="font-serif text-lg text-ink font-semibold tracking-wide">CHRONOS</span>
        <span class="text-2xs font-sans uppercase tracking-[0.2em] text-ink-mute">· admin</span>
        <span class="ml-auto text-2xs font-sans uppercase tracking-widest text-ink-mute"
              data-whoami>verifying…</span>
      </div>
      <div class="h-0.5 bg-gold"></div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto max-w-[1200px] px-4 py-9">
      <h1 class="font-serif text-3xl text-ink leading-tight">Admin review</h1>
      <p class="mt-2 text-sm text-ink-mute">CF Access gated. Mutations are logged with your email.</p>

      <!-- ── Files queue ───────────────────────────────────────────── -->
      <section class="mt-9" data-queue="files">
        <header class="flex items-baseline justify-between border-b border-rule pb-2">
          <h2 class="font-serif text-xl text-ink">Files</h2>
          <span class="text-2xs font-sans uppercase tracking-widest text-ink-mute">
            confidence 0.5–0.7 · awaiting confirmation
          </span>
        </header>
        <div data-list class="mt-4 space-y-3">
          <p class="text-sm italic text-ink-faint" data-empty>Loading…</p>
        </div>
      </section>

      <!-- ── Quarantine queue ──────────────────────────────────────── -->
      <section class="mt-9" data-queue="quarantine">
        <header class="flex items-baseline justify-between border-b border-rule pb-2">
          <h2 class="font-serif text-xl text-ink">Quarantine</h2>
          <span class="text-2xs font-sans uppercase tracking-widest text-ink-mute">
            ClamAV / moderation flags · not public
          </span>
        </header>
        <div data-list class="mt-4 space-y-3">
          <p class="text-sm italic text-ink-faint" data-empty>Loading…</p>
        </div>
      </section>

      <!-- ── Translation queue ─────────────────────────────────────── -->
      <section class="mt-9" data-queue="translations">
        <header class="flex items-baseline justify-between border-b border-rule pb-2">
          <h2 class="font-serif text-xl text-ink">Translations</h2>
          <span class="text-2xs font-sans uppercase tracking-widest text-ink-mute">
            AI drafts · approve to publish
          </span>
        </header>
        <div data-list class="mt-4 space-y-3">
          <p class="text-sm italic text-ink-faint" data-empty>Loading…</p>
        </div>
      </section>

      <div data-toast class="fixed bottom-6 right-6 hidden rounded-md bg-ink text-paper px-4 py-2 text-sm shadow-tooltip"></div>
    </main>

    <script is:inline src="/js/admin-review.js"></script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" bare={true} title="Not found">
  <div class="min-h-dvh flex items-center justify-center px-4 py-16 bg-paper">
    <div class="text-center">
      <p class="text-2xs font-sans uppercase tracking-[0.3em] text-ink-mute">404</p>
      <h1 class="mt-3 font-serif text-3xl text-ink">Lost in history.</h1>
      <p class="mt-3 text-sm italic text-ink-mute">Verlore in die geskiedenis.</p>
      <div class="mt-7 flex justify-center gap-3 text-sm">
        <a href="/" class="rounded-md border border-rule px-3 py-2 no-underline hover:border-gold">Start over</a>
      </div>
    </div>
  </div>
</BaseLayout>
